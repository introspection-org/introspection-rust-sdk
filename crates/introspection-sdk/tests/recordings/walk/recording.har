            "text": "{\"records\":[{\"created_at\":\"2026-10-30T14:19:53.556799Z\",\"updated_at\":\"2026-10-30T14:19:53.584689Z\",\"org_id\":\"01a18d2c-7a83-73d9-91da-5ec680c9e127\",\"id\":\"01a18d2e-715b-761f-aaf3-0e8229017af5\",\"name\":\"hello-mcp\",\"description\":\"Pi coding agent for hello-mcp.\",\"git_ref\":\"main\",\"git_commit_sha\":\"f56ccd18f643fd66cfa1f07a4a002847b33b6016\",\"git_commit_subject\":null,\"sub_path\":\".\",\"project_id\":\"01a18d2e-6cbc-7727-bd05-eeb2d807897f\",\"repository_id\":\"227bc45a-edc7-5682-87e3-3147b8ee8511\",\"slug\":\"hello-mcp-f56ccd1\",\"created_by_member_id\":\"01a18d2c-7a95-75e3-8af4-de67afa5ae67\",\"mcp_servers\":[],\"policies\":null,\"validation\":{\"status\":\"valid\",\"validator_name\":\"introspection-recipe-check\",\"validator_version\":\"0.12.0\",\"checked_at\":\"2026-10-30T14:19:53.583107Z\",\"error_message\":null,\"diagnostics\":[]}}],\"count\":1,\"total_count\":null,\"next\":null}"
