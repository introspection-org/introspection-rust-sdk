            "text": "{\"trace_id\":\"aac28a2408aa2145918b7c676a0d597e\",\"span_id\":\"ae6960b4fe359874\",\"parent_span_id\":\"b80bffd600d39c2d\",\"name\":\"chat scripted-llm\",\"kind\":\"UNSPECIFIED\",\"start_time\":\"2026-11-10T22:14:48.592000Z\",\"duration_ns\":4185112,\"status\":{\"code\":\"Unset\"},\"resource\":{\"service\":{\"name\":\"hello-mcp\"}},\"attributes\":{\"gen_ai\":{\"agent\":{\"id\":\"scripted:01a1c786-74ad-72cd-b14f-e1fb28b50fa1\",\"name\":\"scripted\",\"version\":\"ba60e5d588e7a5935198bf76c5b373020d08d2d3\"},\"conversation\":{\"id\":\"01a1c787-19ce-721a-965a-b7b5e3e94730\"},\"operation\":{\"name\":\"chat\"},\"provider\":{\"name\":\"introspection\"},\"request\":{\"model\":\"scripted-llm\",\"stream\":true},\"response\":{\"finish_reasons\":[\"aborted\"],\"model\":\"scripted-llm\"},\"usage\":{\"input_tokens\":0,\"output_tokens\":0,\"cache_read\":{\"input_tokens\":0},\"cache_creation\":{\"input_tokens\":0}},\"tool\":{\"definitions\":[{\"name\":\"read\",\"description\":\"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.\",\"parameters\":{\"properties\":{\"limit\":{\"description\":\"Maximum number of lines to read\",\"type\":\"number\"},\"offset\":{\"description\":\"Line number to start reading from (1-indexed)\",\"type\":\"number\"},\"path\":{\"description\":\"Path to the file to read (relative or absolute)\",\"type\":\"string\"}},\"required\":[\"path\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"bash\",\"description\":\"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.\",\"parameters\":{\"properties\":{\"command\":{\"description\":\"Shell command to execute\",\"type\":\"string\"},\"timeout\":{\"description\":\"Timeout in seconds (optional, no default timeout)\",\"type\":\"number\"}},\"required\":[\"command\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"write\",\"description\":\"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.\",\"parameters\":{\"properties\":{\"content\":{\"description\":\"Content to write to the file\",\"type\":\"string\"},\"path\":{\"description\":\"Path to the file to write (relative or absolute)\",\"type\":\"string\"}},\"required\":[\"path\",\"content\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"mcp_hello-mcp_echo_921a5a7771\",\"description\":\"Echoes back the input\",\"parameters\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"properties\":{\"message\":{\"description\":\"Message to echo\",\"type\":\"string\"}},\"required\":[\"message\"],\"type\":\"object\"},\"type\":\"function\"}]},\"output\":{\"messages\":[{\"role\":\"assistant\",\"finish_reason\":\"aborted\",\"provider\":\"introspection\",\"model\":\"scripted-llm\",\"api\":\"openai-completions\"}]}},\"introspection\":{\"agent\":{\"depth\":\"0\",\"kind\":\"session\"},\"byok\":false,\"environment\":\"production\",\"ingest\":{\"host\":\"e9e62208f066\",\"time\":1794348888605016},\"member\":{\"id\":\"01a1c786-50ff-70c0-bebc-bb78a49b9e47\"},\"org\":{\"id\":\"01a1c786-50eb-7375-93d2-7a1275fb1856\"},\"project\":{\"id\":\"01a1c786-61eb-71be-ad66-2b8552615586\"},\"recipe\":{\"git_commit_sha\":\"ba60e5d588e7a5935198bf76c5b373020d08d2d3\"},\"run\":{\"id\":\"01a1c787-3172-7313-b21a-7a4ac4322f16\",\"root_id\":\"01a1c787-19ce-721a-965a-b7b418e8bac3\"},\"runtime\":{\"group_id\":\"01a1c786-74ad-72cd-b14f-e1fb28b50fa1\",\"id\":\"01a1c786-7cff-7389-9d1a-7ac2d40a706e\"},\"task\":{\"id\":\"01a1c787-19ce-721a-965a-b7b5e3e94730\",\"run_id\":\"01a1c787-317