            "text": "{\"trace_id\":\"aac28a2408aa2145918b7c676a0d597e\",\"span_id\":\"ae6960b4fe359874\",\"parent_span_id\":\"b80bffd600d39c2d\",\"name\":\"chat scripted-llm\",\"kind\":\"UNSPECIFIED\",\"start_time\":\"2026-11-10T22:14:48.592000Z\",\"duration_ns\":4185112,\"status\":{\"code\":\"Unset\"},\"resource\":{\"introspection\":{\"environment\":\"production\",\"recipe\":{\"git_commit_sha\":\"ba60e5d588e7a5935198bf76c5b373020d08d2d3\"},\"runtime\":{\"group_id\":\"01a1c786-74ad-72cd-b14f-e1fb28b50fa1\",\"id\":\"01a1c786-7cff-7389-9d1a-7ac2d40a706e\"}},\"service\":{\"name\":\"hello-mcp\"}},\"attributes\":{\"gen_ai\":{\"agent\":{\"id\":\"scripted:01a1c786-74ad-72cd-b14f-e1fb28b50fa1\",\"name\":\"scripted\",\"version\":\"ba60e5d588e7a5935198bf76c5b373020d08d2d3\"},\"conversation\":{\"id\":\"01a1c787-19ce-721a-965a-b7b5e3e94730\"},\"operation\":{\"name\":\"chat\"},\"provider\":{\"name\":\"introspection\"},\"request\":{\"model\":\"scripted-llm\",\"stream\":true},\"response\":{\"finish_reasons\":[\"aborted\"],\"model\":\"scripted-llm\"},\"usage\":{\"input_tokens\":0,\"output_tokens\":0,\"cache_read\":{\"input_tokens\":0},\"cache_creation\":{\"input_tokens\":0}},\"tool\":{\"definitions\":[{\"name\":\"read\",\"description\":\"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.\",\"parameters\":{\"properties\":{\"limit\":{\"description\":\"Maximum number of lines to read\",\"type\":\"number\"},\"offset\":{\"description\":\"Line number to start reading from (1-indexed)\",\"type\":\"number\"},\"path\":{\"description\":\"Path to the file to read (relative or absolute)\",\"type\":\"string\"}},\"required\":[\"path\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"bash\",\"description\":\"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.\",\"parameters\":{\"properties\":{\"command\":{\"description\":\"Shell command to execute\",\"type\":\"string\"},\"timeout\":{\"description\":\"Timeout in seconds (optional, no default timeout)\",\"type\":\"number\"}},\"required\":[\"command\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"write\",\"description\":\"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.\",\"parameters\":{\"properties\":{\"content\":{\"description\":\"Content to write to the file\",\"type\":\"string\"},\"path\":{\"description\":\"Path to the file to write (relative or absolute)\",\"type\":\"string\"}},\"required\":[\"path\",\"content\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"mcp_hello-mcp_echo_921a5a7771\",\"description\":\"Echoes back the input\",\"parameters\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"properties\":{\"message\":{\"description\":\"Message to echo\",\"type\":\"string\"}},\"required\":[\"message\"],\"type\":\"object\"},\"type\":\"function\"}]},\"output\":{\"messages\":[{\"role\":\"assistant\",\"finish_reason\":\"aborted\",\"provider\":\"introspection\",\"model\":\"scripted-llm\",\"api\":\"openai-completions\"}]},\"system_instructions\":[{\"type\":\"text\",\"content\":\"Use the declared hello MCP whenever the task asks you to echo a message.\\n## Managed workspace\\n\\n<workspace>\\n  <inputs path=\\\"/workspace/files\\\" access=\\\"read_write\\\" persistence=\\\"task\\\" />\\n  <outputs path=\\\"/workspace/outputs\\\" persistence=\\\"task\\\" />\\n  Save downloaded source material under files/ and deliverables under outputs/. Mounted uploads and recipe files remain read-only; use a new path for modified copies.\\n</workspace>\\nUploaded inputs are read-only. Put intentional task deliverables in the outputs path so the platform can persist them.\\n\\n\\n## Session\\n\\n<session visibility=\\\"project\\\">\\n  <permissions plane=\\\"data\\\">annotations:read conversations:read events:read files:read files:write metrics:read shares:read shares:write tasks:read tasks:write repositories:write telemetry:write git:read</permissions>\\n</session>\\n\\n<cwd>\\n/workspace\\n</cwd>\\n\\n<current_date>\\nToday is Tuesday, November 10, 2026 (2026-11-10), in UTC (UTC+00:00). Read dates the person gives, such as \\\"tomorrow\\\", in this time zone.\\n</current_date>\"}]},\"introspection\":{\"agent\":{\"depth\":\"0\",\"kind\":\"session\"},\"byok\":false,\"environment\":\"production\",\"ingest\":{\"host\":\"e9e62208f066\",\"time\":1794348888605016},\"member\":{\"id\":\"01a1c786-50ff-70c0-bebc-bb78a49b9e47\"},\"org\":{\"id\":\"01a1c786-50eb-7375-93d2-7a1275fb1856\"},\"project\":{\"id\":\"01a1c786-61eb-71be-ad66-2b8552615586\"},\"recipe\":{\"git_commit_sha\":\"ba60e5d588e7a5935198bf76c5b373020d08d2d3\"},\"run\":{\"id\":\"01a1c787-3172-7313-b21a-7a4ac4322f16\",\"root_id\":\"01a1c787-19ce-721a-965a-b7b418e8bac3\"},\"runtime\":{\"group_id\":\"01a1c786-74ad-72cd-b14f-e1fb28b50fa1\",\"id\":\"01a1c786-7cff-7389-9d1a-7ac2d40a706e\"},\"task\":{\"id\":\"01a1c787-19ce-721a-965a-b7b5e3e94730\",\"run_id\":\"01a1c787-3172-7313-b21a-7a4ac4322f16\"},\"termination_reason\":\"cancelled\",\"turn\":3,\"history\":{\"position\":0,\"is_new\":false,\"new_messages\":{\"start\":0,\"end\":0}}},\"server\":{\"address\":\"scripted-llm.introspection.internal\",\"port\":443}}}\n{\"trace_id\":\"aac28a2408aa2145918b7c676a0d597e\",\"span_id\":\"b80bffd600d39c2d\",\"name\":\"invoke_agent scripted\",\"kind\":\"UNSPECIFIED\",\"start_time\":\"2026-11-10T22:14:48.590000Z\",\"duration_ns\":8136400,\"status\":{\"code\":\"Ok\"},\"resource\":{\"introspection\":{\"environment\":\"production\",\"recipe\":{\"git_commit_sha\":\"ba60