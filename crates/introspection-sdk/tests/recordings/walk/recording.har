            "text": "{\"records\":[{\"created_at\":\"2026-11-12T23:54:46.161502Z\",\"updated_at\":\"2026-11-12T23:54:48.107360Z\",\"org_id\":\"01a1d22f-58e8-7623-9a9a-acda78eb38ae\",\"id\":\"01a1d22f-6e27-7551-8e59-0ff4dd617caf\",\"name\":\"hello-mcp\",\"description\":\"Pi coding agent for hello-mcp.\",\"git_ref\":\"main\",\"git_commit_sha\":\"a0d76f122218960ca48c84ea5621e348bb22bb09\",\"git_commit_subject\":null,\"sub_path\":\".\",\"project_id\":\"01a1d22f-67a9-7210-8bd3-2684e12060b7\",\"repository_id\":\"e4f6f0ef-8f9f-55a8-8ce7-6ab5a092c9db\",\"slug\":\"hello-mcp-a0d76f1\",\"created_by_member_id\":\"01a1d22f-58f9-741d-beed-e48d9a3e9934\",\"mcp_servers\":[],\"policies\":null,\"agents\":[\"agent\"],\"issue_providers\":null,\"validation\":{\"status\":\"valid\",\"validator_name\":\"introspection-recipe-check\",\"validator_version\":\"0.27.0\",\"checked_at\":\"2026-11-12T23:54:48.098430Z\",\"error_message\":null,\"diagnostics\":[]}}],\"count\":1,\"total_count\":null,\"next\":null}"
