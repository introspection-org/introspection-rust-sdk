            "text": "{\"records\":[{\"created_at\":\"2026-11-10T22:13:57.305941Z\",\"updated_at\":\"2026-11-10T22:13:59.944960Z\",\"org_id\":\"01a1c786-50eb-7375-93d2-7a1275fb1856\",\"id\":\"01a1c786-69d9-77f2-b720-e7d3721296e6\",\"name\":\"hello-mcp\",\"description\":\"Pi coding agent for hello-mcp.\",\"git_ref\":\"main\",\"git_commit_sha\":\"bb5aa4262d3a27096079a3089533c3e63d52a2cb\",\"git_commit_subject\":null,\"sub_path\":\".\",\"project_id\":\"01a1c786-61eb-71be-ad66-2b8552615586\",\"repository_id\":\"e9605a96-115f-51d3-886b-79b8fbf83a29\",\"slug\":\"hello-mcp-bb5aa42\",\"created_by_member_id\":\"01a1c786-50ff-70c0-bebc-bb78a49b9e47\",\"mcp_servers\":[],\"policies\":null,\"validation\":{\"status\":\"valid\",\"validator_name\":\"introspection-recipe-check\",\"validator_version\":\"0.20.0\",\"checked_at\":\"2026-11-10T22:13:59.941150Z\",\"error_message\":null,\"diagnostics\":[]}}],\"count\":1,\"total_count\":null,\"next\":null}"
