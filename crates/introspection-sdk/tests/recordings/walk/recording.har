            "text": "{\"trace_id\":\"ea741a9094cb45b2011fbaffa298906e\",\"span_id\":\"f71bc8a9b416d3c3\",\"parent_span_id\":\"05bed64fa791981b\",\"name\":\"chat scripted-llm\",\"kind\":\"UNSPECIFIED\",\"start_time\":\"2026-10-28T10:18:56.358000Z\",\"duration_ns\":3313337,\"status\":{\"code\":\"Unset\"},\"resource\":{\"service\":{\"name\":\"hello-mcp\"}},\"attributes\":{\"gen_ai\":{\"agent\":{\"id\":\"scripted:01a18204-f40f-73f9-a059-d9e4a1a4cf06\",\"name\":\"scripted\",\"version\":\"543b8db50a839029b03d7ca7957884d806df646c\"},\"conversation\":{\"id\":\"01a18205-1661-70a6-90f8-17e39a9c9524\"},\"operation\":{\"name\":\"chat\"},\"provider\":{\"name\":\"introspection\"},\"request\":{\"model\":\"scripted-llm\",\"stream\":true},\"response\":{\"finish_reasons\":[\"aborted\"],\"model\":\"scripted-llm\"},\"usage\":{\"input_tokens\":0,\"output_tokens\":0,\"cache_read\":{\"input_tokens\":0},\"cache_creation\":{\"input_tokens\":0}},\"tool\":{\"definitions\":[{\"name\":\"read\",\"description\":\"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.\",\"parameters\":{\"properties\":{\"limit\":{\"description\":\"Maximum number of lines to read\",\"type\":\"number\"},\"offset\":{\"description\":\"Line number to start reading from (1-indexed)\",\"type\":\"number\"},\"path\":{\"description\":\"Path to the file to read (relative or absolute)\",\"type\":\"string\"}},\"required\":[\"path\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"bash\",\"description\":\"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.\",\"parameters\":{\"properties\":{\"command\":{\"description\":\"Shell command to execute\",\"type\":\"string\"},\"timeout\":{\"description\":\"Timeout in seconds (optional, no default timeout)\",\"type\":\"number\"}},\"required\":[\"command\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"write\",\"description\":\"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.\",\"parameters\":{\"properties\":{\"content\":{\"description\":\"Content to write to the file\",\"type\":\"string\"},\"path\":{\"description\":\"Path to the file to write (relative or absolute)\",\"type\":\"string\"}},\"required\":[\"path\",\"content\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"mcp_hello-mcp_echo_921a5a7771\",\"description\":\"Echoes back the input\",\"parameters\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"properties\":{\"message\":{\"description\":\"Message to echo\",\"type\":\"string\"}},\"required\":[\"message\"],\"type\":\"object\"},\"type\":\"function\"}]},\"output\":{\"messages\":[{\"role\":\"assistant\",\"finish_reason\":\"aborted\",\"provider\":\"introspection\",\"model\":\"scripted-llm\",\"api\":\"openai-completions\"}]}},\"introspection\":{\"agent\":{\"depth\":\"0\",\"kind\":\"session\"},\"byok\":false,\"environment\":\"production\",\"ingest\":{\"host\":\"182c965689a0\",\"time\":1793182736368497},\"member\":{\"id\":\"01a18202-4434-7480-8ee3-0402fe9bb475\"},\"org\":{\"id\":\"01a18202-4425-752f-876c-95bdd1b4de21\"},\"project\":{\"id\":\"01a18204-e5f4-7142-8598-a96148ff2fa2\"},\"recipe\":{\"git_commit_sha\":\"543b8db50a839029b03d7ca7957884d806df646c\"},\"run\":{\"id\":\"01a18205-1fab-77ba-bae9-73e3052dfb2f\",\"root_id\":\"01a18205-1661-70a6-90f8-17e2f20549d1\"},\"runtime\":{\"group_id\":\"01a18204-f40f-73f9-a059-d9e4a1a4cf06\",\"id\":\"01a18204-f6d6-7598-8524-4e5c0273eaf6\"},\"task\":{\"id\":\"01a18205-1661-70a6-90f8-17e39a9c9524\",\"run_id\":\"01a18205-1fa