            "text": "{\"trace_id\":\"19d00af424baa2bcad892121ca93e687\",\"span_id\":\"160a38e26a69516d\",\"parent_span_id\":\"0083d0886372cc9b\",\"name\":\"chat scripted-llm\",\"kind\":\"UNSPECIFIED\",\"start_time\":\"2026-10-26T10:04:42.496000Z\",\"duration_ns\":8090033,\"status\":{\"code\":\"Unset\"},\"resource\":{\"service\":{\"name\":\"hello-mcp\"}},\"attributes\":{\"gen_ai\":{\"agent\":{\"id\":\"scripted:01a177ab-3423-774f-b4ef-ee4afb42a116\",\"name\":\"scripted\",\"version\":\"543b8db50a839029b03d7ca7957884d806df646c\"},\"conversation\":{\"id\":\"01a177ab-5638-7561-a0f3-39f30df21e39\"},\"operation\":{\"name\":\"chat\"},\"provider\":{\"name\":\"introspection\"},\"request\":{\"model\":\"scripted-llm\",\"stream\":true},\"response\":{\"finish_reasons\":[\"stop\"],\"id\":\"chatcmpl-aa760d393deb495ab8fa461a981421a7\",\"model\":\"scripted-llm\",\"time_to_first_chunk\":0.007295448000000306},\"usage\":{\"input_tokens\":16,\"output_tokens\":1,\"cache_read\":{\"input_tokens\":0},\"cache_creation\":{\"input_tokens\":0}},\"tool\":{\"definitions\":[{\"name\":\"read\",\"description\":\"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.\",\"parameters\":{\"properties\":{\"limit\":{\"description\":\"Maximum number of lines to read\",\"type\":\"number\"},\"offset\":{\"description\":\"Line number to start reading from (1-indexed)\",\"type\":\"number\"},\"path\":{\"description\":\"Path to the file to read (relative or absolute)\",\"type\":\"string\"}},\"required\":[\"path\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"bash\",\"description\":\"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.\",\"parameters\":{\"properties\":{\"command\":{\"description\":\"Shell command to execute\",\"type\":\"string\"},\"timeout\":{\"description\":\"Timeout in seconds (optional, no default timeout)\",\"type\":\"number\"}},\"required\":[\"command\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"write\",\"description\":\"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.\",\"parameters\":{\"properties\":{\"content\":{\"description\":\"Content to write to the file\",\"type\":\"string\"},\"path\":{\"description\":\"Path to the file to write (relative or absolute)\",\"type\":\"string\"}},\"required\":[\"path\",\"content\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"mcp_hello-mcp_echo_921a5a7771\",\"description\":\"Echoes back the input\",\"parameters\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"properties\":{\"message\":{\"description\":\"Message to echo\",\"type\":\"string\"}},\"required\":[\"message\"],\"type\":\"object\"},\"type\":\"function\"}]},\"output\":{\"messages\":[{\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"content\":\"done\"}],\"finish_reason\":\"stop\",\"provider\":\"introspection\",\"model\":\"scripted-llm\",\"api\":\"openai-completions\",\"response_id\":\"chatcmpl-aa760d393deb495ab8fa461a981421a7\"}]}},\"introspection\":{\"agent\":{\"depth\":\"0\",\"kind\":\"session\"},\"byok\":false,\"contains\":{\"values\":[\"gen_ai.input.messages.role:user\",\"gen_ai.output.messages.parts.type:text\"],\"version\":1},\"environment\":\"production\",\"history\":{\"continuation_method\":\"conversation_id\",\"hash_hit\":true,\"is_new\":false,\"new_messages\":{\"end\":11,\"start\":10},\"position\":6},\"member\":{\"id\":\"01a177a8-5346-74a8-afa7-34123655fa00\"},\"org\":{\"id\":\"01a177a8-5332-7174-9fcf-e6494cabb8ed\"},\"project\":{\"id\":\"01a177ab-252