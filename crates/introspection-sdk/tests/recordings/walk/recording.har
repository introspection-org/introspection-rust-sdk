.\\n## Managed workspace\\n\\n<workspace>\\n  <inputs path=\\\"/workspace/files\\\" access=\\\"read_write\\\" persistence=\\\"task\\\" />\\n  <outputs path=\\\"/workspace/outputs\\\" persistence=\\\"task\\\" />\\n  Save downloaded source material under files/ and deliverables under outputs/. Mounted uploads and recipe files remain read-only; use a new path for modified copies.\\n</workspace>\\nUploaded inputs are read-only. Put intentional task deliverables in the outputs path so the platform can persist them.\\n\\n\\n## Session\\n\\n<session visibility=\\\"project\\\">\\n  <permissions plane=\\\"data\\\">annotations:read conversations:read events:read files:read files:write metrics:read shares:read shares:write tasks:read tasks:write repositories:write telemetry:write git:read</permissions>\\n</session>\\n\\n<cwd>\\n/workspace\\n</cwd>\\n\\n<current_date>\\nToday is Thursday, November 12, 2026 (2026-11-12), in UTC (UTC+00:00). Read dates the person gives, such as \\\"tomorrow\\\", in this time zone.\\n</current_date>\"}]},\"introspection\":{\"agent\":{\"depth\":\"0\",\"kind\":\"session\"},\"byok\":false,\"contains\":{\"values\":[\"gen_ai.input.messages.role:user\",\"gen_ai.output.messages.parts.type:text\"],\"version\":2},\"environment\":\"production\",\"history\":{\"continuation_method\":\"conversation_id\",\"is_new\":false,\"new_messages\":{\"end\":11,\"start\":10},\"position\":6},\"ingest\":{\"host\":\"b0b7fd8d23ef\",\"time\":1794527705098931},\"member\":{\"id\":\"01a1d22f-58f9-741d-beed-e48d9a3e9934\"},\"org\":{\"id\":\"01a1d22f-58e8-7623-9a9a-acda78eb38ae\"},\"project\":{\"id\":\"01a1d22f-67a9-7210-8bd3-2684e12060b7\"},\"recipe\":{\"git_commit_sha\":\"ba60e5d588e7a5935198bf76c5b373020d08d2d3\"},\"run\":{\"id\":\"01a1d22f-b68f-74a2-a489-93a92146c345\",\"root_id\":\"01a1d22f-a2f4-7719-a205-6c4127e36dea\"},\"runtime\":{\"group_id\":\"01a1d22f-78d4-7476-851f-49bcd6c06aa7\",\"id\":\"01a1d22f-7ec5-7376-8467-d12428db89c2\"},\"task\":{\"id\":\"01a1d22f-a2f4-7719-a205-