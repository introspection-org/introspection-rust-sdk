          "postData": {
            "mimeType": "application/json",
            "params": [],
            "text": "{\"prompt\":\"Call the `echo` tool from the declared `hello-mcp` MCP server with the message `hello from the public MCP`. Write the echoed value exactly, with no quotes or additional formatting, to `/workspace/outputs/greeting.txt`. Then run `echo $WALK_MARKER` in the shell and reply in one short sentence.\\n\\n<<SCRIPT {\\\"reply\\\":\\\"Echoed the message through hello-mcp and wrote it to the outputs file.\\\",\\\"tools\\\":[{\\\"name\\\":\\\"hello-mcp_echo\\\",\\\"arguments\\\":{\\\"message\\\":\\\"hello from the public MCP\\\"}},{\\\"name\\\":\\\"write\\\",\\\"arguments\\\":{\\\"path\\\":\\\"/workspace/outputs/greeting.txt\\\",\\\"content\\\":\\\"Echo: hello from the public MCP\\\"}},{\\\"name\\\":\\\"bash\\\",\\\"arguments\\\":{\\\"command\\\":\\\"echo $WALK_MARKER\\\"}}]}>>\",\"agent_name\":\"scripted\",\"files\":[{\"id\":\"01a18d2e-9fc3-714a-9f52-6b2847132a21\"}],\"idle_timeout_seconds\":180,\"metadata\":{\"suite\":\"walk\"}}"
          }
