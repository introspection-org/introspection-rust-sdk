            "text": "{\"sha\":\"543b8db50a839029b03d7ca7957884d806df646c\",\"parents\":[\"e3327a0d0d127aa0c8e690fce48e292caf28b86f\"],\"message\":\"chore: introspection check as npm scripts and a pre-commit hook (#14)\\n\\nThe same check the travel-agent recipe runs: `npm run check`, and a\\npre-commit hook wired by `prepare` (core.hooksPath .githooks).\",\"author\":{\"name\":\"Julian\",\"email\":\"brightsparc@gmail.com\",\"date\":\"2026-10-23T11:54:19-07:00\"},\"committer\":{\"name\":\"GitHub\",\"email\":null,\"date\":\"2026-10-23T11:54:19-07:00\"},\"files\":[{\"filename\":\".githooks/pre-commit\",\"status\":\"added\",\"additions\":4,\"deletions\":0,\"changes\":4},{\"filename\":\"package.json\",\"status\":\"modified\",\"additions\":5,\"deletions\":0,\"changes\":5}],\"patch\":\"diff --git a/.githooks/pre-commit b/.githooks/pre-commit\\nnew file mode 100755\\nindex 0000000..939aac7\\n--- /dev/null\\n+++ b/.githooks/pre-commit\\n@@ -0,0 +1,4 @@\\n+#!/usr/bin/env sh\\n+set -eu\\n+\\n+npm run check\\ndiff --git a/package.json b/package.json\\nindex dc15670..ea68b77 100644\\n--- a/package.json\\n+++ b/package.json\\n@@ -3,6 +3,11 @@\\n   \\\"version\\\": \\\"0.1.0\\\",\\n   \\\"private\\\": true,\\n   \\\"type\\\": \\\"module\\\",\\n+  \\\"scripts\\\": {\\n+    \\\"check\\\": \\\"npx -y -p @introspection-ai/cli@latest introspection check\\\",\\n+    \\\"check:json\\\": \\\"npx -y -p @introspection-ai/cli@latest introspection check --output json\\\",\\n+    \\\"prepare\\\": \\\"git config core.hooksPath .githooks || true\\\"\\n+  },\\n   \\\"peerDependencies\\\": {\\n     \\\"@earendil-works/pi-agent-core\\\": \\\"*\\\",\\n     \\\"@earendil-works/pi-ai\\\": \\\"*\\\",\\n\"}"
