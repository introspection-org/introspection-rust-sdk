            "text": "{\"trace_id\":\"088fa6ae428310d2669792597252eaac\",\"span_id\":\"0a88f63cd1f1bf52\",\"parent_span_id\":\"7cc2534d23260cc5\",\"name\":\"chat scripted-llm\",\"kind\":\"UNSPECIFIED\",\"start_time\":\"2026-10-27T05:14:57.459000Z\",\"duration_ns\":7873074,\"status\":{\"code\":\"Unset\"},\"resource\":{\"service\":{\"name\":\"hello-mcp\"}},\"attributes\":{\"gen_ai\":{\"agent\":{\"id\":\"scripted:01a17bc7-f536-71ca-89b4-63ec6ab67f0d\",\"name\":\"scripted\",\"version\":\"543b8db50a839029b03d7ca7957884d806df646c\"},\"conversation\":{\"id\":\"01a17bc8-5665-7623-80f3-4d74a264d2aa\"},\"operation\":{\"name\":\"chat\"},\"provider\":{\"name\":\"introspection\"},\"request\":{\"model\":\"scripted-llm\",\"stream\":true},\"response\":{\"finish_reasons\":[\"stop\"],\"id\":\"chatcmpl-3fc92b0a8aa24c068f03e5cb7e4e1200\",\"model\":\"scripted-llm\",\"time_to_first_chunk\":0.0069162379999997935},\"usage\":{\"input_tokens\":16,\"output_tokens\":1,\"cache_read\":{\"input_tokens\":0},\"cache_creation\":{\"input_tokens\":0}},\"tool\":{\"definitions\":[{\"name\":\"read\",\"description\":\"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.\",\"parameters\":{\"properties\":{\"limit\":{\"description\":\"Maximum number of lines to read\",\"type\":\"number\"},\"offset\":{\"description\":\"Line number to start reading from (1-indexed)\",\"type\":\"number\"},\"path\":{\"description\":\"Path to the file to read (relative or absolute)\",\"type\":\"string\"}},\"required\":[\"path\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"bash\",\"description\":\"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.\",\"parameters\":{\"properties\":{\"command\":{\"description\":\"Shell command to execute\",\"type\":\"string\"},\"timeout\":{\"description\":\"Timeout in seconds (optional, no default timeout)\",\"type\":\"number\"}},\"required\":[\"command\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"write\",\"description\":\"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.\",\"parameters\":{\"properties\":{\"content\":{\"description\":\"Content to write to the file\",\"type\":\"string\"},\"path\":{\"description\":\"Path to the file to write (relative or absolute)\",\"type\":\"string\"}},\"required\":[\"path\",\"content\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"mcp_hello-mcp_echo_921a5a7771\",\"description\":\"Echoes back the input\",\"parameters\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"properties\":{\"message\":{\"description\":\"Message to echo\",\"type\":\"string\"}},\"required\":[\"message\"],\"type\":\"object\"},\"type\":\"function\"}]},\"output\":{\"messages\":[{\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"content\":\"done\"}],\"finish_reason\":\"stop\",\"provider\":\"introspection\",\"model\":\"scripted-llm\",\"api\":\"openai-completions\",\"response_id\":\"chatcmpl-3fc92b0a8aa24c068f03e5cb7e4e1200\"}]}},\"introspection\":{\"agent\":{\"depth\":\"0\",\"kind\":\"session\"},\"byok\":false,\"contains\":{\"values\":[\"gen_ai.input.messages.role:user\",\"gen_ai.output.messages.parts.type:text\"],\"version\":1},\"environment\":\"production\",\"history\":{\"continuation_method\":\"conversation_id\",\"hash_hit\":true,\"is_new\":false,\"new_messages\":{\"end\":11,\"start\":10},\"position\":6},\"ingest\":{\"host\":\"8264acb78bc2\",\"time\":1793078097479156},\"member\":{\"id\":\"01a17bc6-7d75-75ac-89c9-3b5a8756e35b\"},\"org\":{\"id\":\"01a17bc6